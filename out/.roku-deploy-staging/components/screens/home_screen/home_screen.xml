<?xml version="1.0" encoding="utf-8" ?>
<component name="home_screen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/screens/home_screen/home_screen.brs" />
  <script type="text/brightscript" uri="pkg:/components/helpers/VodEntityHelper.brs" />
  <script type="text/brightscript" uri="pkg:/source/StaticContent.brs" />
  <script type="text/brightscript" uri="pkg:/components/helpers/ChannelEntityHelper.brs" />
  <interface>
    <field id="homeScreenDataEntity" type="array" onChange="updateHomeScreen"/>
    <field id="liveChannelsEntity" type="array" onChange="fetchLiveScreenData"/>
    <field id="lastFocusedChild" type="integer" />
    <!-- onChange="updateHomeScreen" -->
  </interface>
  <children>
    <!-- <default_poster id="default_poster" translation="[0, 0]" visible="true" /> -->
    <!-- <Poster
    id="poster"
    width="1100"
    height="1080"
    loadWidth="1100"
    loadHeight="1080"
    loadDisplayMode="scaleToZoom"
    uri ="pkg:/images/png/shapes/default_overlay.png"
>
 
    </Poster> -->

    <Group id="nestedDetailScene" visible="false" >
      <!-- <DetailsScene  id ="mainDetailScene" translation="[0, 0]" /> -->
    </Group>
    <Group id="mainGroup" visible="true">
      <Group id="itemDetailsGroup" opacity="0.0">
        <HomePlayer id="homePlayer"  visible="true" translation="[600, 0]" ></HomePlayer>
        <ItemDetails id="itemDetailLayout" translation="[180, 0]" visible="true">
        </ItemDetails>
      </Group>
      <Group id="contentContainer" translation="[160, 20]">
        <Rectangle
        width="1920"
        height="1080"
        color="#222222"  translation="[-20, -20]"/>

        <!-- <Poster 
          width="1742"
          height="791"
          translation="[-20, -20]"
          uri ="pkg:/images/png/shapes/animation_background.png"
        /> -->
        <!-- rowItemSize = "[ [442, 310], [250, 350] ]" -->
        <!-- rowItemSpacing = "[ [50,20], [15,20] ]" -->
        <RowList 
          id = "exampleRowList" 
          translation = "[ 0, 0 ]" 
          itemComponentName = "RowListItemComponent" 
          itemSize = "[ 1920, 520 ]" 
          rowItemSize = "[ [300, 420] ]"  
          itemSpacing = "[ 0, 0 ]" 
          rowItemSpacing = "[ [15,20] ]"
          rowLabelOffset="[[0, 15]]"
          showRowLabel = "[ true ]"
          drawFocusFeedback = "true"
          rowHasFocus = "false"
          numRows="2"
          rowFocusAnimationStyle="fixedFocus"
          focusBitmapUri="pkg:/images/png/shapes/focusable_white.9.png"
          />
      </Group>
      <Animation
              id="activateRow"
              duration="0.3"
              repeat="false"
              easeFunction="linear"
          >
        <Vector2DFieldInterpolator
                  id="translationInterpolator"
                  key="[0.0, 1.0]"
                  keyValue="[ [160, 20], [160, 500] ]"
                  fieldToInterp="contentContainer.translation"
              />
      </Animation>
      <Animation
      id="deactivateRow"
      duration="0.5"
      repeat="false"
      easeFunction="OutQuad"
  >
        <Vector2DFieldInterpolator
          id="translationInterpolator"
          key="[0.0, 1.0]"
          keyValue="[ [160, 500], [160, 20]  ]"
          fieldToInterp="contentContainer.translation"
      />
      </Animation>
      <Animation
      id="activateItemDetails"
      duration="1"
      repeat="false"
      easeFunction="OutQuad"
  >
        <FloatFieldInterpolator    id = "opacityInterpolator"   key="[0.0,  1.0]"    keyValue="[0.0, 1.0 ]"       fieldToInterp="itemDetailsGroup.opacity"   />
        <!-- <Vector2DFieldInterpolator
          id="opacityInterpolator"
          key="[0.0, 1.0]"
          keyValue="[0.0, 1.0]"
          fieldToInterp="itemDetailsGroup.opacity"
      /> -->
      </Animation>
      <Animation
      id="deactivateItemDetails"
      duration="1"
      repeat="false"
      easeFunction="OutQuad"
  >
        <FloatFieldInterpolator    id = "opacityInterpolator"   key="[0.0,  1.0]"    keyValue="[ 1.0, 0.0 ]"       fieldToInterp="itemDetailsGroup.opacity"   />
      </Animation>
    </Group>
    <!-- focusBitmapUri="pkg:/images/png/shapes/final_focus_updated.9.png" -->
  </children>
</component>