<?xml version="1.0" encoding="utf-8" ?>
<component name="DeepLinkErrorScene" extends="Group">
  <interface>
    <field id="message" type="string" />
    <field id="close" type="boolean" />
    <field id="triggerHome" type="boolean" />
  </interface>

  <children>
    <!-- Fallback UI (still useful if video fails silently) -->
    <Group id="container" translation="[0,0]" focusable="true">
   
      <Video
      id="video"
      width="1920"
      height="1080"
      translation="[0,0]"
      visible="true"
      />


      <Label
      id="messageLabel"
      translation="[640, 300]"
      horizAlign="center"
      text=""
      font="font:MediumSystemFont"
    />

    <Button
      id="homeButton"
      translation="[1500, 900]"
      text="Go Home"
    />
    </Group>

    <!-- Video player embedded directly -->
    
    
    <!-- Timer for focus fallback -->
    <Timer id="focusTimer" duration="0.5" repeat="true" control="start"/>
  </children>

  <script type="text/brightscript" uri="pkg:/components/DeepLinkErrorScene.brs" />
</component>