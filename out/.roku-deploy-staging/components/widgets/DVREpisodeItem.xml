<component name="DVREpisodeItem" extends="Group">
    <interface>
      <field id="itemContent" type="node" onChange="updateContent" />
    </interface>
  
  <children>
    <!-- Background Rectangle -->
    <Rectangle
      id="background"
      width="380"
      height="310"
      color="0x1A1A1AFF"  
      translation="[0, 0]"
    />
  
    <!-- Thumbnail Image -->
    <Poster id="thumb" width="360" height="202" translation="[10, 10]" />
    
    <!-- Title below thumbnail -->
    <Label
      id="title"
      translation="[10, 216]"
      width="360"
      height="40"
      color="0xFFFFFFFF"
      visible="true"
      horizAlign="left"
      vertAlign="top"
      wrap="true"
      maxLines="2"
      lineSpacing="-2"
      font="font:SmallSystemFont"
    />
    
    <!-- Time below title -->
    <Label
      id="meta"
      translation="[10, 260]"
      width="360"
      height="35"
      color="0xCCCCCCFF"
      font="font:SmallSystemFont"
      visible="true"
      horizAlign="left"
      vertAlign="top"
    />
    
  </children>
  
    <script type="text/brightscript" uri="DVREpisodeItem.brs" />
  </component>