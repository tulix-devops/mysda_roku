<?xml version="1.0" encoding="utf-8" ?>
<!--
  ScChurchTask - the SDA church directory (the Android apps' "YT" tab data,
  as the mysda session described it on 2026-11-18): GET
  livetv.mysdatv.com/api/getfavoritechurch.php, no auth, a RAW JSON array of
  { state, city, church, link } (a { data: [...] } envelope is accepted too).
  Grouped by state in the order states first appear, churches in their own
  order. result: a ContentNode whose children are states
    title (title case)  scCount
  and whose grandchildren are churches
    title (the church)  scCity  scLink  scState
  `done` is set last.
-->
<component name="ScChurchTask" extends="Task">
  <interface>
    <field id="result" type="node" />
    <field id="ok" type="boolean" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/ScTime.brs" />
  <script type="text/brightscript" uri="pkg:/source/ScData.brs" />
  <script type="text/brightscript" uri="pkg:/source/ScNet.brs" />
  <script type="text/brightscript" uri="pkg:/components/sc/tasks/ScChurchTask.brs" />
</component>
