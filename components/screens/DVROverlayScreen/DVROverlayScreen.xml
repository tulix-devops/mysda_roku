<component name="DVROverlayScreen" extends="Group">
    <interface>
      <field id="content" type="array" onChange="onContentLoaded"  />
      <field id="parentContent" type="node" onChange="onParentContentChanged"  />
      <field id="requestOverlayClose" type="bool"  />
      <field id="selectedDvrItem" type="node" />
    </interface>
  
    <children>
  
      <!-- Semi-transparent background -->
      <Poster
      id="gradient"
      uri="pkg:/images/png/gradient.png"
      width="1920"
      height="1080"
      translation="[0, 0]"
      ></Poster>
      <!-- Horizontal Layout: Sidebar + List -->
      <Group translation="[90, 90]">
      
          <Label
          id="parentTitle"
          translation="[0, 0]"
          width="1000"
          height="40"
          color="0xFFFFFFFF"
          ><Font role="font" uri="pkg:/images/UrbanistBold.ttf" size="36" />  
      </Label>
      </Group>

      <Group translation="[1730, 90]">
        <Label
        id="timeTitle"
        translation="[0, 0]"
        width="150"
        height="40"
        color="0xFFFFFFFF"
        ><Font role="font" uri="pkg:/images/UrbanistRegular.ttf" size="36" />  
        </Label>
      </Group>
      
      <Group translation="[640, 160]">
        <Label
        id="episodeTitle"
        translation="[0, 0]"
        width="500"
        text=""
        height="40"
        color="0xFFFFFFFF"
        ><Font role="font" uri="pkg:/images/UrbanistRegular.ttf" size="24" />  
        </Label>
      </Group>

      <Group translation="[90, 200]" >
      
        <!-- Left: DVR Day/Section List -->
        <MarkupList
          id="dvrSidebar"
          itemComponentName="DVRSidebarItem"
          itemSize="[450, 70]"
          focusBitmapBlendColor="0x442255AA"
          vertFocusAnimationStyle="floatingFocus"
        />
        <!-- Right: DVR Episode List (Grid: 3 columns x 3 rows) -->
     
      <MarkupGrid
        id="dvrEpisodes"
        itemComponentName="DVREpisodeItem"
        itemSize="[380, 310]"
        translation="[550, 0]"
        numColumns="3"
        numRows="3"
        itemSpacing="[15, 20]"
        drawFocusFeedback="true"
        focusBitmapBlendColor="0x66CCFF"
        vertFocusAnimationStyle="fixedFocus"
      />
      </Group>
    </children>
    <script type="text/brightscript" uri="DVROverlayScreen.brs" />
  </component>





  