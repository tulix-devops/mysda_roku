<?xml version="1.0" encoding="utf-8" ?>
<!--
  third_vod - "Radios": one grid of the catalogue, in the WPALive layout
  (redesign 2026-10-06; the four grid screens share this layout - vod_screen,
  second_vod, third_vod, dvr_vod - and differ only in their feed and heading).

  Laid out ONCE, for the COLLAPSED rail: the page content starts at x 160 and
  runs to 1860 (1700 wide). The open rail slides vodContainer right by 320
  (slidePage in the .brs) and never re-lays it.

  Grid: five 330x195 tiles across (5 x 330 + 4 x 12 = 1698). The grid sits 30
  left and 20 up of the tiles (each tile is padded back by sdPadLeft 30 /
  sdPadTop 20 on its content node) and the last column spacing is 60: a
  MarkupGrid cuts items at its own content box, and the focus glow reaches 30
  past a tile (knowledge/dev-roku/markupgrid-clips-at-content-box).

  Node ids the .brs reads are kept: vodContainer, vodRowList,
  descriptionLabel, timeTitle, userEmailLabel, the itemDetails group and the
  MoveCategoryIn/Out animations.
-->
<component name="third_vod" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/screens/third_vod/third_vod.brs" />
  <script type="text/brightscript" uri="pkg:/source/StaticContent.brs" />
  <script type="text/brightscript" uri="pkg:/components/helpers/VodEntityHelper.brs" />
  <script type="text/brightscript" uri="pkg:/components/helpers/CategoryEntityHelper.brs" />
  <interface>
    <field id="vodDataEntity" type="array" onChange="updateVodScreen"/>
    <field id="lastFocusedChild" type="integer" />
    <field id="showFullContent" type="boolean" value="false" alwaysNotify="true" onChange="onShowFullContentChanged"/>
  </interface>
  <children>
    <Group id="itemDetailsGroup" opacity="0.0">
      <HomePlayer id="vodPlayer" visible="true" translation="[400, 0]" />
      <ItemDetails id="vodItemDetails" translation="[20, 0]" visible="true" />
    </Group>

    <!-- The legacy clock and e-mail line: still written by the .brs, no
         longer shown (SdClock below keeps the time current). -->
    <Group visible="false">
      <Label id="userEmailLabel" text="" />
      <Label id="timeTitle" text="" />
    </Group>

    <Group id="vodContainer" translation="[160, 0]">
      <SdTopBar id="topBar" translation="[0, 48]" heading="Radios" />

      <!-- The focused tile's title is in its caption now; the old
           "title - on mySDAtv" line is kept for the .brs, never shown. -->
      <Group visible="false">
        <Label id="descriptionLabel" text="" />
      </Group>

      <MarkupGrid
          id="vodRowList"
          translation="[-30, 238]"
          itemComponentName="SdTile"
          itemSize="[330, 252]"
          itemSpacing="[12, 18]"
          columnSpacings="[12, 12, 12, 12, 60]"
          numColumns="5"
          numRows="3"
          drawFocusFeedback="false"
          vertFocusAnimationStyle="fixedFocus" />
    </Group>

    <SdClock id="sdClock" translation="[1440, 48]" />

    <!-- Legacy animations, kept for the .brs; not started on any live path. -->
    <Animation id="activateRow" duration="0.3" repeat="false" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[ [160, 0], [160, 0] ]" fieldToInterp="vodContainer.translation" />
    </Animation>
    <Animation id="deactivateRow" duration="0.3" repeat="false" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[ [160, 0], [160, 0] ]" fieldToInterp="vodContainer.translation" />
    </Animation>
    <Animation id="activateItemDetails" duration="1" repeat="false" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 0.0]" fieldToInterp="itemDetailsGroup.opacity" />
    </Animation>
    <Animation id="deactivateItemDetails" duration="1" repeat="false" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 0.0]" fieldToInterp="itemDetailsGroup.opacity" />
    </Animation>

    <!-- The page slide beside the rail: 0.18 s closing, 0.22 s opening,
         outCubic, the rail's own timing. keyValue is rewritten from the
         current position each time (slidePage). -->
    <Animation id="MoveCategoryIn" duration="0.18" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="CategoryListIn" key="[0.0, 1.0]"
          keyValue="[ [480, 0], [160, 0] ]" fieldToInterp="vodContainer.translation" />
    </Animation>
    <Animation id="MoveCategoryOut" duration="0.22" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="CategoryListOut" key="[0.0, 1.0]"
          keyValue="[ [160, 0], [480, 0] ]" fieldToInterp="vodContainer.translation" />
    </Animation>
  </children>
</component>
