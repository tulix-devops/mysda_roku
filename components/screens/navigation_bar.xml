<?xml version="1.0" encoding="utf-8"?>
<!--
  navigation_bar - the left rail, redesigned 2026-10-06 on wpa_live_roku's
  WpNavRail: a 120 px column of glyphs that opens to 440 px with labels.

  THE CONTRACT IS UNCHANGED: the node id, the isVisible field (true = open,
  focus in the rail), selectedIndex and userLoggedIn, which the grid screens,
  the player and the DVR flow all set by name. Only the drawing is new.

  Opening changes ONLY THE RAIL: the panel widens and the labels fade in; the
  glyphs and the mark never move. The grid screens slide their own page
  right by 320 with the same timing (slidePage), keeping one layout.

  Rows are built in code (two groups with a gap; a MarkupList cannot
  interleave a gap). Declaration order is draw order: panel, edge, the
  fading layer (lockup, pills, labels), mark, glyphs.
-->
<component name="navigation_bar" extends="Group">
    <script type="text/brightscript" uri="pkg:/source/SdGlobals.brs" />
    <script type="text/brightscript" uri="pkg:/source/SdTheme.brs" />
    <script type="text/brightscript" uri="pkg:/source/SdMetrics.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/navigation_bar.brs" />
    <interface>
        <field id="isVisible" type="boolean" onChange="toggleNavVisibility" />
        <field id="selectedIndex" type="integer" value="0" />
        <field id="userLoggedIn" type="boolean" onChange="onUserLoggedIn" />
    </interface>
    <children>
        <!-- The ground's own left fade under the collapsed rail's glyphs:
             a glow or caption scrolling past x 130 fades rather than ends.
             In the rail so it hides with it when the player is up. -->
        <Poster id="leftEdgeFade" uri="" width="150" height="1080" />

        <!-- Initial values are the COLLAPSED state: the channel boots with
             focus in the Television grid. -->
        <Rectangle id="railPanel" width="120" height="1080" color="0x00000000" opacity="0" />

        <Group id="railRight" translation="[120, 0]" opacity="0">
            <Rectangle id="railEdge" width="1" height="1080" translation="[-1, 0]" color="0x1E3D66FF" />
        </Group>

        <!-- Everything only the open rail shows. One group, one fade. -->
        <Group id="fadeLayer" opacity="0">
            <!-- "mySDAtv" beside the globe, in the logo's own three colours:
                 "my" red, "SDA" gold, "tv" blue. A horizontal LayoutGroup
                 centred on the mark's middle (y 66), so no width is guessed. -->
            <LayoutGroup id="railTitle" layoutDirection="horiz" vertAlignment="center"
                         itemSpacings="[0]" translation="[108, 66]">
                <Label id="railTitleMy" text="my" height="48" vertAlign="center" color="0xF0262BFF">
                    <Font role="font" uri="pkg:/images/fonts/Manrope-ExtraBold.ttf" size="36" />
                </Label>
                <Label id="railTitleSda" text="SDA" height="48" vertAlign="center" color="0xFAD35AFF">
                    <Font role="font" uri="pkg:/images/fonts/Manrope-ExtraBold.ttf" size="36" />
                </Label>
                <Label id="railTitleTv" text="tv" height="48" vertAlign="center" color="0x0981FBFF">
                    <Font role="font" uri="pkg:/images/fonts/Manrope-ExtraBold.ttf" size="36" />
                </Label>
            </LayoutGroup>
            <Group id="itemsContainer" translation="[0, 176]" />
        </Group>

        <!-- The globe, authored at exactly 60x60, centred on the collapsed
             rail (x 30..90) and left there in both states. -->
        <Poster id="railMark" uri="pkg:/images/png/brand/mark_60.png"
                width="60" height="60" loadWidth="60" loadHeight="60"
                translation="[30, 36]" />

        <!-- The glyphs, above the pills, at one x in both states. -->
        <Group id="iconsContainer" translation="[0, 176]" />

        <!-- Open and close. keyValues are written from the CURRENT values
             each time, so a reversal half-way continues from where it is. -->
        <Animation id="railAnim" duration="0.22" repeat="false" easeFunction="outCubic">
            <FloatFieldInterpolator id="panelWInterp" key="[0.0, 1.0]"
                keyValue="[120.0, 120.0]" fieldToInterp="railPanel.width" />
            <FloatFieldInterpolator id="panelOpInterp" key="[0.0, 1.0]"
                keyValue="[0.0, 0.0]" fieldToInterp="railPanel.opacity" />
            <Vector2DFieldInterpolator id="rightPosInterp" key="[0.0, 1.0]"
                keyValue="[ [120.0, 0.0], [120.0, 0.0] ]" fieldToInterp="railRight.translation" />
            <FloatFieldInterpolator id="rightOpInterp" key="[0.0, 1.0]"
                keyValue="[0.0, 0.0]" fieldToInterp="railRight.opacity" />
            <FloatFieldInterpolator id="fadeOpInterp" key="[0.0, 1.0]"
                keyValue="[0.0, 0.0]" fieldToInterp="fadeLayer.opacity" />
        </Animation>
    </children>
</component>
