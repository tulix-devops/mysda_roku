<?xml version="1.0" encoding="UTF-8" ?>
<!--
  LoginInfoScreen - what the account row of the rail previews while it is in
  hand: why DVR needs a subscription, and the donation QR code. Passive: the
  rail keeps focus and OK there starts the login / logout flow.

  Redesign 2026-10-06 (WPALive layout). It is only ever on screen with the
  rail OPEN, so it is laid out for the open rail: content from x 480 to 1860.
-->
<component name="LoginInfoScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/source/SdGlobals.brs" />
    <script type="text/brightscript" uri="pkg:/source/SdTheme.brs" />
    <script type="text/brightscript" uri="pkg:/source/SdMetrics.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/LoginInfoScreen.brs" />
    <children>
        <SdTopBar id="topBar" translation="[480, 48]" heading="DVR access" />

        <Label
            id="messageLabel"
            text="Unfortunately, because the cost of storage to record 24/7 for every channel is high, we are forced to charge a small subscription to help offset this additional expense. If you would like to enjoy the DVR features of 21 days recordings, download option to share your favorite programs with others and direct access to thousands of programs from church libraries, subscribe now at https://mysdatv.com then come back with your Log In and password to watch any program you may have missed.&#10;&#10;(*If you rather give a tax deduction donation to mySDAtv, you can use the DVR features for one entire year for free).&#10;&#10;*Temporary promotion"
            width="840"
            height="660"
            color="0xB4BCCBFF"
            wrap="true"
            lineSpacing="9"
            translation="[480, 258]">
            <Font role="font" uri="pkg:/images/fonts/Inter-Medium.ttf" size="27" />
        </Label>

        <!-- The QR on a surface card: a rounded plate, the code on its own
             white square (a QR needs its quiet zone), the caption under it. -->
        <Group translation="[1416, 258]">
            <Poster id="qrPlate" uri="pkg:/images/png/shapes/pill_r18.9.png"
                    width="384" height="444" />
            <Poster id="qrWhite" uri="pkg:/images/png/shapes/pill_r9.9.png"
                    width="324" height="324" translation="[30, 30]" />
            <Poster
                id="donationQR"
                uri="pkg:/images/png/donation.PNG"
                width="300"
                height="300"
                loadWidth="300"
                loadHeight="300"
                loadDisplayMode="scaleToFit"
                translation="[42, 42]" />
            <Label
                id="donationLabel"
                text="Donation QR code"
                width="384"
                height="60"
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center"
                translation="[0, 366]">
                <Font role="font" uri="pkg:/images/fonts/Inter-SemiBold.ttf" size="27" />
            </Label>
        </Group>

        <!-- The hint: what OK does here. -->
        <Group translation="[480, 960]">
            <Poster id="hintPlate" uri="pkg:/images/png/shapes/pill_r9.9.png"
                    width="78" height="48" />
            <Label id="hintKey" text="OK" width="78" height="48"
                   horizAlign="center" vertAlign="center" color="0x04142BFF">
                <Font role="font" uri="pkg:/images/fonts/Inter-Bold.ttf" size="24" />
            </Label>
            <Label
                id="instructionsLabel"
                text="to proceed with Login/Logout"
                width="900"
                height="48"
                color="0xB4BCCBFF"
                vertAlign="center"
                translation="[96, 0]">
                <Font role="font" uri="pkg:/images/fonts/Inter-Medium.ttf" size="27" />
            </Label>
        </Group>
    </children>
</component>
