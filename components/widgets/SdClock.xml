<?xml version="1.0" encoding="utf-8" ?>
<!--
  SdClock - the time and the day on a rounded surface plate, top right of
  every screen (WPALive's scene clock, as a widget so the DVR overlay, which
  is appended over the scene, can carry its own). It keeps itself current:
  the legacy screens set their clock once in init and never again.
-->
<component name="SdClock" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/SdGlobals.brs" />
  <script type="text/brightscript" uri="pkg:/source/SdTheme.brs" />
  <script type="text/brightscript" uri="pkg:/source/SdMetrics.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/SdClock.brs" />
  <children>
    <Poster id="clockPlate" uri="pkg:/images/png/shapes/pill_r9.9.png"
            width="420" height="60" />
    <Label id="clockTime" text="" translation="[24, 0]" width="150" height="60"
           vertAlign="center" color="0xFFFFFFFF">
      <Font role="font" uri="pkg:/images/fonts/Manrope-Bold.ttf" size="30" />
    </Label>
    <Label id="clockDay" text="" translation="[0, 0]" width="396" height="60"
           horizAlign="right" vertAlign="center" color="0xB4BCCBFF">
      <Font role="font" uri="pkg:/images/fonts/Inter-Medium.ttf" size="21" />
    </Label>
    <Timer id="clockTimer" duration="20" repeat="true" />
  </children>
</component>
