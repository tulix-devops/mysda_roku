<?xml version="1.0" encoding="UTF-8"?>
<!--
  DVREpisodeItem - one recording (or the channel's Live entry) in the DVR
  overlay's grid. Redesign 2026-10-06: it works out the picture, the title
  and the time from the recording exactly as before, and hands them to the
  channel's one tile (SdTile) to draw, forwarding the grid's focus.
-->
<component name="DVREpisodeItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="updateContent" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
    <field id="gridHasFocus" type="boolean" onChange="onFocusChanged" />
  </interface>

  <children>
    <SdTile id="tile" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/widgets/DVREpisodeItem.brs" />
</component>
